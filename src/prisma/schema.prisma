datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model EventDraft {
  id          String   @id @default(uuid())
  title       String
  description String?
  date        DateTime
  status      String   @default("pending")
  createdAt   DateTime @default(now())
}

model SolarEvent {
  id          String   @id @default(uuid())
  title       String
  description String?
  date        DateTime
  createdAt   DateTime @default(now())
}
